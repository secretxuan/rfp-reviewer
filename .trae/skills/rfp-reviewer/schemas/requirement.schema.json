{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Requirement",
  "type": "object",
  "required": ["requirement_id", "category", "mandatory_level", "source", "text"],
  "properties": {
    "requirement_id": {"type": "string"},
    "category": {"type": "string", "enum": ["project_info", "deadline", "qualification", "form", "business", "technical", "price", "contract", "scoring", "invalid_bid", "other"]},
    "mandatory_level": {"type": "string", "enum": ["fatal", "high", "medium", "low", "info"]},
    "source": {
      "type": "object",
      "required": ["file", "locator"],
      "properties": {"file": {"type": "string"}, "locator": {"type": "string"}, "section": {"type": "string"}}
    },
    "text": {"type": "string"},
    "required_evidence": {"type": "array", "items": {"type": "string"}},
    "keywords": {"type": "array", "items": {"type": "string"}},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1}
  }
}
