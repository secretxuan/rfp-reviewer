{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeviationTableRow",
  "type": "object",
  "required": ["requirement_id", "source", "requirement_text", "response_or_evidence", "deviation", "risk_level", "suggested_action"],
  "properties": {
    "requirement_id": {"type": "string"},
    "source": {"type": "string"},
    "requirement_text": {"type": "string"},
    "response_or_evidence": {"type": "string"},
    "deviation": {"type": "string", "enum": ["正偏离", "无偏离/完全响应", "负偏离", "部分响应", "存疑", "未响应"]},
    "risk_level": {"type": "string"},
    "suggested_action": {"type": "string"},
    "human_review_required": {"type": "boolean"}
  }
}
